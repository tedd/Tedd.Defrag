<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Tedd.Defrag.Desktop.MainPage" BackgroundColor="{StaticResource Canvas}">
  <Grid ColumnDefinitions="204,*,306" RowDefinitions="*,42" ColumnSpacing="22" Padding="0,0,22,0">
    <Border Grid.RowSpan="2" Stroke="#1D2937" Background="#0D1621" Padding="20,28,16,18" StrokeShape="Rectangle">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="28">
        <VerticalStackLayout Spacing="5"><Label Text="▦  TEDD" FontSize="27" FontAttributes="Bold" CharacterSpacing="3" TextColor="{StaticResource Accent}" /><Label Text="D E F R A G" FontSize="10" Margin="37,0,0,0" TextColor="#A0B2C5" /></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="7"><Button Text="◉   Overview" Clicked="OnOverview" BackgroundColor="#193A40" TextColor="{StaticResource Accent}" /><Button Text="≡   Activity &amp; history" Clicked="OnHistory" BackgroundColor="Transparent" /><Button Text="◷   Schedules" Clicked="OnSchedules" BackgroundColor="Transparent" /></VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Spacing="12"><Label Text="YOUR VOLUMES" Style="{StaticResource Caption}" /><VerticalStackLayout x:Name="VolumesPanel" Spacing="8" /><Button Text="↻  Refresh volumes" Clicked="OnRefreshVolumes" BackgroundColor="Transparent" TextColor="#8095A9" FontSize="11" /></VerticalStackLayout>
        <Border Grid.Row="4" Stroke="#27424A" Background="#11262C" StrokeShape="RoundRectangle 10" Padding="12"><VerticalStackLayout Spacing="6"><Label Text="A lighter footprint." FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" /><Label Text="Move only what helps. Keep your work in focus." FontSize="11" TextColor="#94AEB9" LineHeight="1.3" /></VerticalStackLayout></Border>
      </Grid>
    </Border>
    <ScrollView Grid.Column="1" Margin="0,28,0,18">
      <VerticalStackLayout Spacing="20">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="7"><Label Text="STORAGE INTELLIGENCE" Style="{StaticResource Caption}" TextColor="{StaticResource Accent}" /><Label Grid.Row="1" Text="Storage, in perspective." FontSize="30" FontAttributes="Bold" /><Border Grid.Column="1" Grid.RowSpan="2" Background="#182536" Stroke="#2B3C50" StrokeShape="RoundRectangle 8" Padding="12,8" VerticalOptions="Center"><Label x:Name="ModeBadge" Text="SELECT VOLUME" FontSize="10" CharacterSpacing="1" TextColor="#B7C9DF" /></Border></Grid>
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
          <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="FREE SPACE" Style="{StaticResource Caption}" /><Label x:Name="FreeMetric" Text="—" FontSize="27" /><Label x:Name="CapacityDetail" Text="Select a volume" FontSize="11" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border>
          <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="FRAGMENTED STREAMS" Style="{StaticResource Caption}" /><Label x:Name="FragmentMetric" Text="—" FontSize="27" TextColor="#F5AF71" /><Label x:Name="StreamDetail" Text="Awaiting analysis" FontSize="11" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="RELOCATED &amp; VERIFIED" Style="{StaticResource Caption}" /><Label x:Name="MovedMetric" Text="0 B" FontSize="27" TextColor="{StaticResource Accent}" /><Label x:Name="BudgetDetail" Text="Within your write budget" FontSize="11" TextColor="{StaticResource Muted}" /></VerticalStackLayout></Border>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="20"><VerticalStackLayout Spacing="14">
          <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="5"><Label x:Name="VolumeTitle" Text="Volume allocation map" FontSize="17" FontFamily="OpenSansSemibold" /><Label x:Name="MapSubtitle" Text="A live view of logical allocation" FontSize="11" TextColor="{StaticResource Muted}" /></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="5"><Button Text="−" Clicked="OnZoomOut" Padding="12,6" /><Button Text="+" Clicked="OnZoomIn" Padding="12,6" /><Button Text="Reset" Clicked="OnResetZoom" Padding="10,6" /></HorizontalStackLayout></Grid>
          <GraphicsView x:Name="DiskMap" HeightRequest="276" HorizontalOptions="Fill" BackgroundColor="#0C141F" StartHoverInteraction="OnMapHover" MoveHoverInteraction="OnMapHover" StartInteraction="OnMapClick" />
          <Grid ColumnDefinitions="*,Auto"><Label x:Name="MapRange" Text="LOWER LCN" FontSize="9" TextColor="#687F95" CharacterSpacing="1" /><Label Grid.Column="1" Text="HIGHER LCN →" FontSize="9" TextColor="#687F95" CharacterSpacing="1" /></Grid>
          <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"><Label Text="■  Allocated" TextColor="#4EC8C3" FontSize="11" /><Label Text="■  Fragmented" TextColor="#F5AF71" FontSize="11" /><Label Text="■  Metadata" TextColor="#A995F5" FontSize="11" /><Label Text="■  Excluded" TextColor="#718499" FontSize="11" /><Label Text="■  Free" TextColor="#567086" FontSize="11" /><Label Text="■  Activity" TextColor="#E5EEF4" FontSize="11" /></FlexLayout>
          <Label x:Name="CellDetail" Text="Hover to inspect a cell. Click to center the next zoom." FontSize="11" TextColor="#8DA5BB" />
        </VerticalStackLayout></Border>
        <Border Style="{StaticResource Card}" Padding="18,16"><VerticalStackLayout Spacing="12">
          <Grid ColumnDefinitions="*,Auto"><Label x:Name="JobTitle" Text="Ready when you are" FontSize="15" FontFamily="OpenSansSemibold" /><Label x:Name="ProgressText" Grid.Column="1" Text="READY" FontSize="10" TextColor="{StaticResource Accent}" CharacterSpacing="1" /></Grid>
          <ProgressBar x:Name="JobProgress" Progress="0" ProgressColor="{StaticResource Accent}" BackgroundColor="#243347" HeightRequest="5" /><Label x:Name="JobMessage" Text="Analyze a volume before making changes." FontSize="12" TextColor="{StaticResource Muted}" MaxLines="3" LineBreakMode="TailTruncation" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Label x:Name="ObservationText" Text="No disk operations running" FontSize="10" TextColor="#72899F" VerticalOptions="Center" /><Button x:Name="PauseButton" Grid.Column="1" Text="Pause" Clicked="OnPause" IsEnabled="False" Padding="14,7" /><Button x:Name="CancelButton" Grid.Column="2" Text="Cancel" Clicked="OnCancel" IsEnabled="False" Padding="14,7" BackgroundColor="#352735" TextColor="#E6AFB8" /></Grid>
        </VerticalStackLayout></Border>
        <Grid ColumnDefinitions="*,Auto"><Label Text="Files worth a closer look" FontSize="17" FontFamily="OpenSansSemibold" /><Button Grid.Column="1" Text="Export report ↗" Clicked="OnExport" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" Padding="8,0" /></Grid>
        <Border Style="{StaticResource Card}" Padding="0"><VerticalStackLayout>
          <Grid ColumnDefinitions="*,80,90" Padding="16,12" BackgroundColor="#152130"><Label Text="FILE / STREAM" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="EXTENTS" Style="{StaticResource Caption}" /><Label Grid.Column="2" Text="SIZE" Style="{StaticResource Caption}" HorizontalOptions="End" /></Grid>
          <CollectionView x:Name="FileList" HeightRequest="220" SelectionMode="Single" SelectionChanged="OnFileSelected"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,65,95" Padding="16,11" RowDefinitions="Auto,Auto" RowSpacing="3"><Label Text="{Binding Path}" FontSize="11" LineBreakMode="MiddleTruncation" /><Label Grid.Row="1" Text="{Binding Status}" FontSize="9" TextColor="#708AA1" /><Label Grid.Column="1" Text="{Binding Extents}" TextColor="#F5AF71" HorizontalOptions="Center" /><Label Grid.Column="2" Text="{Binding BytesLabel}" FontSize="11" HorizontalOptions="End" /></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Analyzed fragmented streams will appear here." Padding="20" TextColor="{StaticResource Muted}" /></CollectionView.EmptyView></CollectionView>
        </VerticalStackLayout></Border>
        <Label x:Name="WarningsText" FontSize="11" TextColor="#859AAF" LineHeight="1.3" />
      </VerticalStackLayout>
    </ScrollView>
    <ScrollView Grid.Column="2" Margin="0,30,0,18"><VerticalStackLayout Spacing="18">
      <Border Style="{StaticResource Card}" Stroke="#34565B" Background="#12242C"><VerticalStackLayout Spacing="13">
        <Label Text="YOUR NEXT MOVE" Style="{StaticResource Caption}" TextColor="{StaticResource Accent}" /><Label Text="Intentional optimization." FontSize="20" FontFamily="OpenSansSemibold" /><Label Text="Choose an objective. Preview its cost. Move within your limits." FontSize="12" TextColor="#A3B8C5" LineHeight="1.3" />
        <Picker x:Name="PolicyPicker" Title="Layout policy" /><Entry x:Name="SelectedPath" Placeholder="Selected file or folder (optional)" /><Entry x:Name="ExclusionEntry" Placeholder="Exclude paths / globs; separate with ;" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button x:Name="AnalyzeButton" Text="Analyze" Clicked="OnAnalyze" IsEnabled="False" BackgroundColor="#23424B" /><Button x:Name="PreviewButton" Grid.Column="1" Text="Preview" Clicked="OnPreview" IsEnabled="False" BackgroundColor="#23424B" /></Grid><Button x:Name="OptimizeButton" Text="Run optimization  →" Clicked="OnOptimize" IsEnabled="False" BackgroundColor="{StaticResource Accent}" TextColor="#082329" />
      </VerticalStackLayout></Border>
      <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="13">
        <Label Text="Resource budget" FontSize="16" FontFamily="OpenSansSemibold" /><Picker x:Name="ResourcePreset" Title="Resource preset" SelectedIndexChanged="OnPresetChanged" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="CPU ceiling" TextColor="{StaticResource Muted}" /><Label x:Name="CpuValue" Grid.Column="1" Text="25%" TextColor="{StaticResource Accent}" /></Grid><Slider x:Name="CpuSlider" Minimum="1" Maximum="100" Value="25" ValueChanged="OnResourceChanged" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Memory cap" TextColor="{StaticResource Muted}" /><Label x:Name="MemoryValue" Grid.Column="1" Text="1,024 MiB" TextColor="{StaticResource Accent}" /></Grid><Slider x:Name="MemorySlider" Minimum="256" Maximum="8192" Value="1024" ValueChanged="OnResourceChanged" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Relocation bandwidth" TextColor="{StaticResource Muted}" /><Label x:Name="IoValue" Grid.Column="1" Text="32 MiB/s" TextColor="{StaticResource Accent}" /></Grid><Slider x:Name="IoSlider" Minimum="1" Maximum="512" Value="32" ValueChanged="OnResourceChanged" />
        <Grid ColumnDefinitions="*,Auto"><Label Text="Only while idle" VerticalOptions="Center" /><Switch x:Name="IdleSwitch" Grid.Column="1" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="AC power only" VerticalOptions="Center" /><Switch x:Name="AcSwitch" Grid.Column="1" IsToggled="True" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Background priority" VerticalOptions="Center" /><Switch x:Name="BackgroundSwitch" Grid.Column="1" IsToggled="True" /></Grid>
        <Entry x:Name="AffinityEntry" Placeholder="CPU affinity · hex mask, or automatic" /><Label Text="Affinity limits eligible cores. It does not guarantee cache isolation." FontSize="10" TextColor="#7B93A9" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="WRITE BUDGET · MiB" FontSize="9" TextColor="{StaticResource Muted}" /><Entry x:Name="BudgetEntry" Text="10240" Keyboard="Numeric" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="TIME LIMIT · MIN" FontSize="9" TextColor="{StaticResource Muted}" /><Entry x:Name="MinutesEntry" Text="60" Keyboard="Numeric" /></VerticalStackLayout></Grid><Entry x:Name="BoundaryEntry" Placeholder="Shrink boundary · MiB (if selected)" Keyboard="Numeric" />
      </VerticalStackLayout></Border>
      <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="Storage concurrency" FontSize="15" FontFamily="OpenSansSemibold" /><Label Text="Volumes sharing a disk queue automatically." FontSize="11" TextColor="{StaticResource Muted}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Allow shared-disk parallelism" FontSize="11" VerticalOptions="Center" /><Switch x:Name="SharedSwitch" Grid.Column="1" /></Grid><Entry x:Name="ParallelEntry" Text="2" Keyboard="Numeric" Placeholder="Concurrent volumes" /><Button Text="Save concurrency settings" Clicked="OnSaveConcurrency" /><Label x:Name="TopologyText" FontSize="10" TextColor="#7892AA" /></VerticalStackLayout></Border>
    </VerticalStackLayout></ScrollView>
    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" VerticalOptions="Center"><Label x:Name="FooterStatus" Text="●  Discovering available volumes…" FontSize="10" TextColor="{StaticResource Accent}" /><Label Grid.Column="1" Text="NTFS  /  .NET 11  /  TEDD" FontSize="9" CharacterSpacing="1" TextColor="#697E93" /></Grid>
  </Grid>
</ContentPage>
