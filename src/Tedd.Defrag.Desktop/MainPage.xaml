<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:Tedd.Defrag.Desktop" xmlns:tedd="clr-namespace:Tedd.Maui;assembly=Tedd.WriteableBitmap.Maui" x:Class="Tedd.Defrag.Desktop.MainPage" BackgroundColor="{DynamicResource Canvas}">
  <Grid x:Name="RootGrid">
    <Grid x:Name="Workspace" ColumnDefinitions="204,*,306" RowDefinitions="*,42" ColumnSpacing="22" Padding="0,0,22,0">
      <Border Grid.RowSpan="2" Stroke="{DynamicResource SidebarLine}" Background="{DynamicResource Sidebar}" Padding="20,28,16,18" StrokeShape="Rectangle">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="28">
          <VerticalStackLayout Spacing="5"><Label Text="▦  TEDD" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource SidebarText}" /><Label Text="DEFRAG" FontSize="27" FontAttributes="Bold" CharacterSpacing="3" TextColor="{DynamicResource Accent}" /></VerticalStackLayout>
          <VerticalStackLayout Grid.Row="1" Spacing="7"><Button x:Name="OverviewButton" Text="◉   Overview" Clicked="OnOverview" BackgroundColor="{DynamicResource NavSelected}" TextColor="{DynamicResource Accent}" /><Button Text="≡   Activity &amp; history" Clicked="OnHistory" BackgroundColor="Transparent" /><Button x:Name="SettingsButton" Text="⚙   Settings" Clicked="OnSettings" BackgroundColor="Transparent" /></VerticalStackLayout>
          <VerticalStackLayout Grid.Row="2" Spacing="12"><Label Text="YOUR VOLUMES" Style="{StaticResource Caption}" /><VerticalStackLayout x:Name="VolumesPanel" Spacing="8" /><Button Text="↻  Refresh volumes" Clicked="OnRefreshVolumes" BackgroundColor="Transparent" TextColor="{DynamicResource SubtleText}" FontSize="11" /></VerticalStackLayout>
          <Border Grid.Row="4" Stroke="{DynamicResource NoticeLine}" Background="{DynamicResource NoticeSurface}" StrokeShape="RoundRectangle 10" Padding="12"><VerticalStackLayout Spacing="6"><Label Text="Administrator mode" FontFamily="OpenSansSemibold" TextColor="{DynamicResource Accent}" /><Label Text="Volume analysis and maintenance require administrator access." FontSize="11" TextColor="{DynamicResource NoticeText}" LineHeight="1.3" /></VerticalStackLayout></Border>
        </Grid>
      </Border>

      <ScrollView x:Name="OverviewContent" Grid.Column="1" Margin="0,28,0,18">
        <VerticalStackLayout Spacing="20">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="7"><Label Text="STORAGE INTELLIGENCE" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label Grid.Row="1" Text="Advanced Defrag, Open Source, Free" FontSize="30" FontAttributes="Bold" /><Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource BadgeSurface}" Stroke="{DynamicResource BadgeLine}" StrokeShape="RoundRectangle 8" Padding="12,8" VerticalOptions="Center"><Label x:Name="ModeBadge" Text="SELECT VOLUME" FontSize="10" CharacterSpacing="1" TextColor="{DynamicResource BadgeText}" /></Border></Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="FREE SPACE" Style="{StaticResource Caption}" /><Label x:Name="FreeMetric" Text="—" FontSize="27" /><Label x:Name="CapacityDetail" Text="Select a volume" FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="FRAGMENTED STREAMS" Style="{StaticResource Caption}" /><Label x:Name="FragmentMetric" Text="—" FontSize="27" TextColor="{DynamicResource Fragmented}" /><Label x:Name="StreamDetail" Text="Awaiting analysis" FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="RELOCATED" Style="{StaticResource Caption}" /><Label x:Name="MovedMetric" Text="0 B" FontSize="27" TextColor="{DynamicResource Accent}" /><Label x:Name="BudgetDetail" Text="No relocation limit" FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout></Border>
          </Grid>
          <Border Style="{StaticResource Card}" Padding="20"><VerticalStackLayout Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="5"><Label x:Name="VolumeTitle" Text="Volume allocation map" FontSize="17" FontFamily="OpenSansSemibold" /><Label x:Name="MapSubtitle" Text="A live view of logical allocation" FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="5"><Button x:Name="RegionSelectButton" Text="Select region" Clicked="OnSelectRegion" Padding="10,6" IsEnabled="False" /><Button x:Name="LocateFileButton" Text="Locate file" Clicked="OnLocateFile" Padding="10,6" /><Button x:Name="ZoomOutButton" Text="−" Clicked="OnZoomOut" Padding="12,6" IsEnabled="False" /><Button x:Name="ZoomInButton" Text="+" Clicked="OnZoomIn" Padding="12,6" IsEnabled="False" /><Button x:Name="ResetMapButton" Text="Reset" Clicked="OnResetZoom" Padding="10,6" IsEnabled="False" /></HorizontalStackLayout></Grid>
            <Grid HeightRequest="276"><tedd:WriteableBitmapView x:Name="DiskMapBitmap" Aspect="Fill" InputTransparent="True" /><GraphicsView x:Name="DiskMap" BackgroundColor="Transparent" /><Label x:Name="MapEmptyMessage" InputTransparent="True" Text="Select a volume to begin." HorizontalTextAlignment="Center" VerticalTextAlignment="Center" TextColor="SlateGray" FontSize="13" /></Grid>
            <VerticalStackLayout Spacing="5"><Grid ColumnDefinitions="*,Auto"><Label x:Name="MapNavigationHint" Text="ZOOM IN OR SELECT A REGION TO PAN · CTRL+SCROLL TO ZOOM" FontSize="9" TextColor="{DynamicResource SubtleText}" CharacterSpacing="1" /><Label x:Name="MapRange" Grid.Column="1" Text="FULL VOLUME" FontSize="9" TextColor="{DynamicResource SubtleText}" CharacterSpacing="1" /></Grid><Grid HeightRequest="42"><tedd:WriteableBitmapView x:Name="MapOverviewBitmap" Aspect="Fill" InputTransparent="True" /><GraphicsView x:Name="MapOverview" BackgroundColor="Transparent" /></Grid></VerticalStackLayout>
            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource FreeSpace}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Free" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource Allocated}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Files" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource Excluded}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Immovable / excluded" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource Metadata}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Metadata / directories" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource Activity}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Moving" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="{DynamicResource Verified}" Stroke="{DynamicResource Muted}" StrokeThickness="1" /><Label Text="Move verified" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,14,6"><Border WidthRequest="12" HeightRequest="12" Padding="0" Background="Transparent" Stroke="{DynamicResource Highlight}" StrokeThickness="2" /><Label Text="Selection outline" FontSize="11" /></HorizontalStackLayout>
              <HorizontalStackLayout Spacing="5" Margin="0,0,0,6"><Border WidthRequest="42" HeightRequest="12" Padding="0" Stroke="{DynamicResource Muted}" StrokeThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource FragmentedLow}" Offset="0" /><GradientStop Color="{DynamicResource Fragmented}" Offset="1" /></LinearGradientBrush></Border.Background></Border><Label Text="Fragmented density: low to high" FontSize="11" /></HorizontalStackLayout>
            </FlexLayout>
            <Label Text="Red intensity shows the share of each cell occupied by fragmented files. Movement and verified moves override file colors; metadata and immovable files take precedence in mixed cells." FontSize="10" TextColor="{DynamicResource Muted}" />
            <Label x:Name="CellDetail" Text="Hover to inspect a cluster range. Click for files; drag to pan." FontSize="11" TextColor="{DynamicResource SubtleText}" LineBreakMode="MiddleTruncation" MaxLines="1" />
            <Label x:Name="HighlightedFile" IsVisible="False" FontSize="11" TextColor="{DynamicResource HighlightText}" LineBreakMode="MiddleTruncation" MaxLines="1" />
          </VerticalStackLayout></Border>
          <Border Style="{StaticResource Card}" Padding="18,16"><VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto"><Label x:Name="JobTitle" Text="Ready when you are" FontSize="15" FontFamily="OpenSansSemibold" /><Label x:Name="ProgressText" Grid.Column="1" Text="READY" FontSize="10" TextColor="{DynamicResource Accent}" CharacterSpacing="1" /></Grid>
            <ProgressBar x:Name="JobProgress" Progress="0" ProgressColor="{DynamicResource Accent}" BackgroundColor="{DynamicResource Track}" HeightRequest="5" />
            <VerticalStackLayout x:Name="PhaseProgressPanel" IsVisible="False" Spacing="4">
              <Label x:Name="PhaseProgressText" FontSize="10" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="End" />
              <ProgressBar x:Name="PhaseProgress" Progress="0" ProgressColor="{DynamicResource Accent}" BackgroundColor="{DynamicResource Track}" HeightRequest="3" />
            </VerticalStackLayout>
            <Label x:Name="JobMessage" Text="Analyze a volume before making changes." FontSize="12" TextColor="{DynamicResource Muted}" MaxLines="3" LineBreakMode="TailTruncation" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><Label x:Name="ObservationText" Text="No disk operations running" FontSize="10" TextColor="{DynamicResource SubtleText}" VerticalOptions="Center" /><Button Grid.Column="1" Text="Performance details" Clicked="OnPerformanceDetails" Padding="14,7" /><Button x:Name="PauseButton" Grid.Column="2" Text="Pause" Clicked="OnPause" IsVisible="False" IsEnabled="False" Padding="14,7" /><Button x:Name="CancelButton" Grid.Column="3" Text="Cancel" Clicked="OnCancel" IsVisible="False" IsEnabled="False" Padding="14,7" BackgroundColor="{DynamicResource DangerSurface}" TextColor="{DynamicResource DangerText}" /></Grid>
          </VerticalStackLayout></Border>
          <Grid ColumnDefinitions="*,Auto"><Label Text="Files worth a closer look" FontSize="17" FontFamily="OpenSansSemibold" /><Button Grid.Column="1" Text="Export report ↗" Clicked="OnExport" BackgroundColor="Transparent" TextColor="{DynamicResource Accent}" Padding="8,0" /></Grid>
          <Border Style="{StaticResource Card}" Padding="0"><VerticalStackLayout>
            <Grid ColumnDefinitions="*,80,90" Padding="16,12" BackgroundColor="{DynamicResource HeaderSurface}"><Label Text="FILE / STREAM" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="EXTENTS" Style="{StaticResource Caption}" /><Label Grid.Column="2" Text="SIZE" Style="{StaticResource Caption}" HorizontalOptions="End" /></Grid>
            <CollectionView x:Name="FileList" HeightRequest="220" SelectionMode="Single" SelectionChanged="OnFileSelected"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,65,95" Padding="16,11" RowDefinitions="Auto,Auto" RowSpacing="3"><Label Text="{Binding Path}" FontSize="11" LineBreakMode="MiddleTruncation" MaxLines="1" /><Label Grid.Row="1" Text="{Binding Status}" FontSize="9" TextColor="{DynamicResource SubtleText}" /><Label Grid.Column="1" Text="{Binding Extents}" TextColor="{DynamicResource Fragmented}" HorizontalOptions="Center" /><Label Grid.Column="2" Text="{Binding BytesLabel}" FontSize="11" HorizontalOptions="End" /></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Analyzed fragmented streams will appear here." Padding="20" TextColor="{DynamicResource Muted}" /></CollectionView.EmptyView></CollectionView>
          </VerticalStackLayout></Border>
          <Grid ColumnDefinitions="*,Auto"><Label Text="Compressed files" FontSize="17" FontFamily="OpenSansSemibold" /><Label x:Name="CompressionInventorySummary" Grid.Column="1" Text="Analyze an NTFS volume to inspect compression." FontSize="10" TextColor="{DynamicResource Muted}" VerticalOptions="Center" /></Grid>
          <Border Style="{StaticResource Card}" Padding="0"><VerticalStackLayout>
            <Grid ColumnDefinitions="*,105,90,90,65" Padding="16,12" BackgroundColor="{DynamicResource HeaderSurface}"><Label Text="FILE" Style="{StaticResource Caption}" /><Label Grid.Column="1" Text="TYPE" Style="{StaticResource Caption}" /><Label Grid.Column="2" Text="SIZE" Style="{StaticResource Caption}" HorizontalOptions="End" /><Label Grid.Column="3" Text="SAVED" Style="{StaticResource Caption}" HorizontalOptions="End" /><Label Grid.Column="4" Text="SAVED %" Style="{StaticResource Caption}" HorizontalOptions="End" /></Grid>
            <CollectionView x:Name="CompressedFileList" HeightRequest="240" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,105,90,90,65" Padding="16,11"><Label Text="{Binding Path}" FontSize="11" LineBreakMode="MiddleTruncation" MaxLines="1" /><Label Grid.Column="1" Text="{Binding Type}" FontSize="10" TextColor="{DynamicResource Muted}" /><Label Grid.Column="2" Text="{Binding SizeLabel}" FontSize="11" HorizontalOptions="End" /><Label Grid.Column="3" Text="{Binding SavedLabel}" FontSize="11" HorizontalOptions="End" /><Label Grid.Column="4" Text="{Binding PercentLabel}" FontSize="11" HorizontalOptions="End" /></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="No compressed files were found in the latest NTFS analysis." Padding="20" TextColor="{DynamicResource Muted}" /></CollectionView.EmptyView></CollectionView>
          </VerticalStackLayout></Border>
          <Label x:Name="WarningsText" FontSize="11" TextColor="{DynamicResource SubtleText}" LineHeight="1.3" />
        </VerticalStackLayout>
      </ScrollView>

      <ScrollView x:Name="ActionContent" Grid.Column="2" Margin="0,30,0,18"><VerticalStackLayout Spacing="18">
        <Border Style="{StaticResource Card}" Stroke="{DynamicResource ActionLine}" Background="{DynamicResource ActionSurface}"><VerticalStackLayout Spacing="13">
          <Label Text="YOUR NEXT MOVE" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label Text="Intentional optimization." FontSize="20" FontFamily="OpenSansSemibold" /><Label Text="Analyze first, then preview or run the selected method. Use Choose method to change it." FontSize="12" TextColor="{DynamicResource NoticeText}" LineHeight="1.3" />
          <Border Stroke="{DynamicResource ActionLine}" Background="{DynamicResource ActionInner}" StrokeShape="RoundRectangle 10" Padding="12">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChooseMethod" /></Border.GestureRecognizers>
            <Grid ColumnDefinitions="42,*" RowDefinitions="Auto,Auto" ColumnSpacing="10"><Label x:Name="SelectedMethodIcon" Text="↯" FontSize="25" TextColor="{DynamicResource Accent}" VerticalOptions="Center" Grid.RowSpan="2" /><Label x:Name="SelectedMethodName" Grid.Column="1" Text="Minimum-write defrag" FontFamily="OpenSansSemibold" /><Label x:Name="SelectedMethodDescription" Grid.Row="1" Grid.Column="1" Text="Consolidates only heavily fragmented files and preserves existing anchors where possible." FontSize="10" TextColor="{DynamicResource Muted}" LineHeight="1.25" /></Grid>
          </Border>
          <Button Text="Choose method" Clicked="OnChooseMethod" BackgroundColor="{DynamicResource ActionButton}" /><Label x:Name="SettingsInputError" IsVisible="False" FontSize="11" TextColor="{DynamicResource DangerText}" /><Button x:Name="ReviewInputButton" Text="Review settings" IsVisible="False" Clicked="OnReviewInput" BackgroundColor="{DynamicResource ActionButton}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button x:Name="AnalyzeButton" Text="Analyze" Clicked="OnAnalyze" IsEnabled="False" BackgroundColor="{DynamicResource ActionButton}" /><Button x:Name="PreviewButton" Grid.Column="1" Text="Preview selected method" Clicked="OnPreview" IsEnabled="False" BackgroundColor="{DynamicResource ActionButton}" /></Grid><Button x:Name="OptimizeButton" Text="Run selected method  →" Clicked="OnOptimize" IsEnabled="False" BackgroundColor="{DynamicResource Accent}" TextColor="{DynamicResource PrimaryText}" />
        </VerticalStackLayout></Border>
        <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><Label Text="RECOMMENDATION" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label x:Name="RecommendationMedia" Grid.Column="1" Text="UNKNOWN MEDIA" Style="{StaticResource Caption}" /></Grid>
          <Label x:Name="RecommendationTitle" Text="Analyze this volume" FontSize="17" FontFamily="OpenSansSemibold" />
          <Label x:Name="RecommendationSummary" Text="A scan is required before Tedd Defrag can recommend maintenance." FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" />
          <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="8">
            <Label Text="Fragmentation" FontSize="10" TextColor="{DynamicResource Muted}" /><Label x:Name="RecommendationFragmentation" Grid.Column="1" Text="Not measured" FontSize="10" HorizontalTextAlignment="End" />
            <Label Grid.Row="1" Text="File threshold" FontSize="10" TextColor="{DynamicResource Muted}" /><Label x:Name="RecommendationThreshold" Grid.Row="1" Grid.Column="1" Text="20 fragments" FontSize="10" HorizontalTextAlignment="End" />
            <Label Grid.Row="2" Text="Observed rate" FontSize="10" TextColor="{DynamicResource Muted}" /><Label x:Name="RecommendationPerformance" Grid.Row="2" Grid.Column="1" Text="Not measured" FontSize="10" HorizontalTextAlignment="End" />
            <Label Grid.Row="3" Text="Metadata" FontSize="10" TextColor="{DynamicResource Muted}" /><Label x:Name="RecommendationMetadata" Grid.Row="3" Grid.Column="1" Text="Not measured" FontSize="10" HorizontalTextAlignment="End" />
          </Grid>
          <Label Text="Worst fragmented streams" FontSize="10" TextColor="{DynamicResource Muted}" />
          <Label x:Name="RecommendationCulprits" Text="Analyze to identify them." FontSize="10" LineHeight="1.3" LineBreakMode="TailTruncation" MaxLines="4" />
          <Label x:Name="RecommendationStepsLabel" Text="Recommended operations · select one" FontSize="10" TextColor="{DynamicResource Muted}" IsVisible="False" />
          <VerticalStackLayout x:Name="RecommendationSteps" Spacing="6" IsVisible="False">
            <BindableLayout.ItemTemplate><DataTemplate><Button Text="{Binding Name}" CommandParameter="{Binding Operation}" Clicked="OnSelectRecommendedMethod" BackgroundColor="{DynamicResource ActionButton}" /></DataTemplate></BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Button x:Name="RecommendationButton" Text="Analyze now" Clicked="OnUseRecommendation" BackgroundColor="{DynamicResource ActionButton}" />
        </VerticalStackLayout></Border>
        <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Label Text="Current scope" FontSize="15" FontFamily="OpenSansSemibold" /><Label x:Name="ScopeSummary" Text="All files · exclusions none · 20-fragment defrag threshold · all sizes" FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" /><Button Text="Edit in Settings" Clicked="OnSettings" BackgroundColor="Transparent" TextColor="{DynamicResource Accent}" HorizontalOptions="Start" Padding="0,6" /></VerticalStackLayout></Border>
      </VerticalStackLayout></ScrollView>

      <ScrollView x:Name="SettingsContent" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,28,0,18" IsVisible="False">
        <VerticalStackLayout Spacing="20">
          <VerticalStackLayout Spacing="7"><Label Text="OPERATION SETTINGS" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label Text="Scope, limits, appearance, and resource policy." FontSize="30" FontAttributes="Bold" /><Label Text="These values apply to subsequent previews and runs." FontSize="12" TextColor="{DynamicResource Muted}" /></VerticalStackLayout>
          <Border Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*,220" ColumnSpacing="24">
              <VerticalStackLayout Spacing="4"><Label Text="Appearance" FontSize="17" FontFamily="OpenSansSemibold" /><Label Text="Follow the Windows theme automatically, or keep a manual light or dark override." FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout>
              <Picker x:Name="ThemePicker" Grid.Column="1" Title="Appearance" SelectedIndexChanged="OnThemeChanged" VerticalOptions="Center" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}"><VerticalStackLayout Spacing="13">
              <Label Text="Files and exclusions" FontSize="17" FontFamily="OpenSansSemibold" />
              <Label Text="Add one file, folder, wildcard, glob, or regular expression per entry. An empty Files list includes the entire volume. Exclusions always override file entries." FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" />
              <Label Text="FILES TO INCLUDE" FontSize="9" TextColor="{DynamicResource Muted}" />
              <Grid ColumnDefinitions="126,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="FileRuleKind" Title="Match type" SelectedIndexChanged="OnRuleKindChanged" />
                <Entry x:Name="FileRulePattern" Grid.Column="1" Placeholder="File, folder, wildcard, glob, or regular expression" Completed="OnAddFileRule" />
                <Button x:Name="FileRuleBrowseButton" Grid.Column="2" Text="Choose file" Clicked="OnBrowseFileRule" Padding="14,8" />
                <Button x:Name="FileRuleCommitButton" Grid.Column="3" Text="Add" Clicked="OnAddFileRule" Padding="14,8" />
                <Button x:Name="FileRuleCancelButton" Grid.Column="4" Text="Cancel" Clicked="OnCancelFileRuleEdit" Padding="14,8" IsVisible="False" />
              </Grid>
              <VerticalStackLayout x:Name="FileRulesList" Spacing="6" />
              <Label Text="EXCLUSIONS" FontSize="9" TextColor="{DynamicResource Muted}" />
              <Grid ColumnDefinitions="126,*,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="ExclusionRuleKind" Title="Match type" SelectedIndexChanged="OnRuleKindChanged" />
                <Entry x:Name="ExclusionRulePattern" Grid.Column="1" Placeholder="Never move matches" Completed="OnAddExclusionRule" />
                <Button x:Name="ExclusionRuleBrowseButton" Grid.Column="2" Text="Choose file" Clicked="OnBrowseExclusionRule" Padding="14,8" />
                <Button x:Name="ExclusionRuleCommitButton" Grid.Column="3" Text="Add" Clicked="OnAddExclusionRule" Padding="14,8" />
                <Button x:Name="ExclusionRuleCancelButton" Grid.Column="4" Text="Cancel" Clicked="OnCancelExclusionRuleEdit" Padding="14,8" IsVisible="False" />
              </Grid>
              <VerticalStackLayout x:Name="ExclusionRulesList" Spacing="6" />
              <Label Text="File entries select one file. Folder entries include that folder's descendants. Wildcards let * span directories. Globs keep * within one directory and use ** recursively. Regular expressions are case-insensitive. Patterns are matched against the full path." FontSize="10" TextColor="{DynamicResource SubtleText}" LineHeight="1.35" />
            </VerticalStackLayout></Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}"><VerticalStackLayout Spacing="13">
              <Label Text="Compression" FontSize="17" FontFamily="OpenSansSemibold" />
              <Label x:Name="CompressionNotice" Text="Compression targets are applied before the MFT is read and are available only on NTFS volumes." FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" />
              <Grid ColumnDefinitions="126,*,178,Auto,Auto,Auto" ColumnSpacing="8">
                <Picker x:Name="CompressionRuleKind" Title="Match type" SelectedIndexChanged="OnRuleKindChanged" />
                <Entry x:Name="CompressionRulePattern" Grid.Column="1" Placeholder="File, folder, wildcard, glob, or regular expression" Completed="OnAddCompressionRule" />
                <Picker x:Name="CompressionModePicker" Grid.Column="2" Title="Compression type" />
                <Button x:Name="CompressionRuleBrowseButton" Grid.Column="3" Text="Choose file" Clicked="OnBrowseCompressionRule" Padding="14,8" />
                <Button x:Name="CompressionRuleCommitButton" Grid.Column="4" Text="Add" Clicked="OnAddCompressionRule" Padding="14,8" />
                <Button x:Name="CompressionRuleCancelButton" Grid.Column="5" Text="Cancel" Clicked="OnCancelCompressionRuleEdit" Padding="14,8" IsVisible="False" />
              </Grid>
              <VerticalStackLayout x:Name="CompressionRulesList" Spacing="6" />
              <Label Text="EXCLUDE FILE TYPES" FontSize="9" TextColor="{DynamicResource Muted}" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry x:Name="CompressionExtensionEntry" Placeholder="Extensions separated by commas, for example .zip, .jpg" Completed="OnAddCompressionExtensions" />
                <Button Grid.Column="1" Text="Add" Clicked="OnAddCompressionExtensions" Padding="14,8" />
                <Button Grid.Column="2" Text="Reset defaults" Clicked="OnResetCompressionExtensions" Padding="14,8" />
              </Grid>
              <Label x:Name="CompressionExtensionsSummary" FontSize="10" TextColor="{DynamicResource SubtleText}" />
              <FlexLayout x:Name="CompressionExtensionsList" Wrap="Wrap" Direction="Row" />
              <Label Text="NONE removes NTFS or WOF file compression. XPRESS and LZX use the Windows Overlay Filter file provider. Try all tests every algorithm only for currently uncompressed files, retains the smallest result, and can be write-intensive." FontSize="10" TextColor="{DynamicResource SubtleText}" LineHeight="1.35" />
            </VerticalStackLayout></Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}"><VerticalStackLayout Spacing="13">
              <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="4"><Label Text="Performance utilization" FontSize="17" FontFamily="OpenSansSemibold" /><Label Text="Control resource use and operation constraints for subsequent previews and runs." FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout><Button x:Name="AdvancedToggle" Grid.Column="1" Text="Show controls" Clicked="OnToggleAdvanced" Padding="14,8" /></Grid>
              <Label x:Name="SettingsPageInputError" IsVisible="False" FontSize="11" TextColor="{DynamicResource DangerText}" /><VerticalStackLayout x:Name="AdvancedPanel" IsVisible="False" Spacing="13">
                <Picker x:Name="ResourcePreset" Title="Resource preset" SelectedIndexChanged="OnPresetChanged" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                  <VerticalStackLayout><Label Text="COMPRESSION WORKERS · 0–32" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="CompressionWorkersEntry" Text="0" Keyboard="Numeric" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="1"><Label Text="MFT WORKERS · 0–32" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="ScanWorkersEntry" Text="0" Keyboard="Numeric" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="2"><Label Text="PLANNER WORKERS · 0–32" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="PlanningWorkersEntry" Text="0" Keyboard="Numeric" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="3"><Label Text="MOVE QUEUE DEPTH · 1–16" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MoveQueueEntry" Text="16" Keyboard="Numeric" /></VerticalStackLayout>
                </Grid>
                <Label Text="Performance is the default: automatic compression, scan, and planning concurrency, up to 16 independent file moves, and no CPU, memory, or bandwidth throttle. Zero selects an automatic worker count. Metadata operations remain serial. On HDDs, a deep move queue may increase seeking; select Balanced if responsiveness matters." FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" />
                <VerticalStackLayout Spacing="4"><Grid ColumnDefinitions="*,Auto"><Label Text="Verify each relocation" VerticalOptions="Center" /><Switch x:Name="VerifyMovesSwitch" Grid.Column="1" IsToggled="True" Toggled="OnSettingsValueChanged" /></Grid><Label Text="Disabling this skips the post-move extent read for speed. It does not discard file data: NTFS still validates each relocation. The mandatory final scan reconciles the actual layout if disk activity changed the plan." FontSize="10" TextColor="{DynamicResource SubtleText}" LineHeight="1.35" /></VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto"><Label Text="CPU ceiling" TextColor="{DynamicResource Muted}" /><Label x:Name="CpuValue" Grid.Column="1" Text="100%" TextColor="{DynamicResource Accent}" /></Grid><Slider x:Name="CpuSlider" Minimum="1" Maximum="100" Value="100" ValueChanged="OnResourceChanged" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <VerticalStackLayout><Label Text="MEMORY CAP · MiB" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MemoryEntry" Text="0" Keyboard="Numeric" Placeholder="0 · unlimited" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="1"><Label Text="RELOCATION BANDWIDTH · MiB/s" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="IoEntry" Text="0" Keyboard="Numeric" Placeholder="0 · unlimited" /></VerticalStackLayout>
                </Grid>
                <Label Text="Enter whole MiB/s; 0 disables pacing. For reference, 7.5 GiB/s is 7,680 MiB/s. A nonzero memory cap must be at least 256 MiB." FontSize="10" TextColor="{DynamicResource SubtleText}" />
                <Grid ColumnDefinitions="*,Auto"><Label Text="Only while idle" VerticalOptions="Center" /><Switch x:Name="IdleSwitch" Grid.Column="1" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="AC power only" VerticalOptions="Center" /><Switch x:Name="AcSwitch" Grid.Column="1" /></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Background priority" VerticalOptions="Center" /><Switch x:Name="BackgroundSwitch" Grid.Column="1" /></Grid>
                <local:ConstrainedEntry x:Name="AffinityEntry" Placeholder="CPU affinity · hex mask, or automatic" /><Label Text="Affinity limits eligible cores. It does not guarantee cache isolation." FontSize="10" TextColor="{DynamicResource SubtleText}" />
                <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,5" />
                <Label Text="Operation constraints" FontSize="15" FontFamily="OpenSansSemibold" />
                <Label Text="Zero means unlimited. Limits are useful for maintenance windows; they are not required for ordinary operation." FontSize="11" TextColor="{DynamicResource Muted}" LineHeight="1.3" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="WRITE BUDGET · MiB" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="BudgetEntry" Text="0" Keyboard="Numeric" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="TIME LIMIT · MIN" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MinutesEntry" Text="0" Keyboard="Numeric" /></VerticalStackLayout></Grid>
                <VerticalStackLayout><Label Text="SHRINK BOUNDARY · MiB" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="BoundaryEntry" Placeholder="Required only by Prepare for shrink" Keyboard="Numeric" /></VerticalStackLayout>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <VerticalStackLayout><Label Text="MINIMUM FRAGMENTS · 2+" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MinFragmentsEntry" Text="20" Keyboard="Numeric" TextChanged="OnScopeChanged" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="1"><Label Text="MIN FILE · MiB" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MinFileSizeEntry" Placeholder="Any" Keyboard="Numeric" TextChanged="OnScopeChanged" /></VerticalStackLayout>
                  <VerticalStackLayout Grid.Column="2"><Label Text="MAX FILE · MiB" FontSize="9" TextColor="{DynamicResource Muted}" /><local:ConstrainedEntry x:Name="MaxFileSizeEntry" Placeholder="Any" Keyboard="Numeric" TextChanged="OnScopeChanged" /></VerticalStackLayout>
                </Grid>
                <Label Text="Twenty fragments is a conservative write-avoidance default. The threshold applies to Minimum-write and Defragment files; packing and ordering methods ignore it." FontSize="10" TextColor="{DynamicResource SubtleText}" LineHeight="1.35" />
                <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,5" />
                <Label Text="Storage concurrency" FontSize="15" FontFamily="OpenSansSemibold" /><Label Text="Volumes sharing a disk queue automatically." FontSize="11" TextColor="{DynamicResource Muted}" /><Grid ColumnDefinitions="*,Auto"><Label Text="Allow shared-disk parallelism" FontSize="11" VerticalOptions="Center" /><Switch x:Name="SharedSwitch" Grid.Column="1" /></Grid><local:ConstrainedEntry x:Name="ParallelEntry" Text="2" Keyboard="Numeric" Placeholder="Concurrent volumes" /><Button x:Name="SaveConcurrencyButton" Text="Save concurrency settings" Clicked="OnSaveConcurrency" /><Label x:Name="TopologyText" FontSize="10" TextColor="{DynamicResource SubtleText}" />
              </VerticalStackLayout>
            </VerticalStackLayout></Border>
          </Grid>
        </VerticalStackLayout>
      </ScrollView>

      <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" VerticalOptions="Center"><Label x:Name="FooterStatus" Text="●  Discovering available volumes…" FontSize="10" TextColor="{DynamicResource Accent}" /><Label Grid.Column="1" Text="NTFS · ReFS · FAT  /  .NET 11  /  TEDD" FontSize="9" CharacterSpacing="1" TextColor="{DynamicResource SubtleText}" /><VerticalStackLayout x:Name="UpdateProgressPanel" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" Spacing="3"><Label x:Name="UpdateStatus" FontSize="10" TextColor="{DynamicResource Accent}" /><ProgressBar x:Name="UpdateDownloadProgress" Progress="0" ProgressColor="{DynamicResource Accent}" BackgroundColor="{DynamicResource Track}" HeightRequest="4" /></VerticalStackLayout></Grid>
    </Grid>

    <Grid x:Name="ClusterOverlay" IsVisible="False" BackgroundColor="{DynamicResource Overlay}" Padding="60" ZIndex="110">
      <Border Style="{StaticResource Card}" WidthRequest="760" MaximumHeightRequest="680" HorizontalOptions="Center" VerticalOptions="Center" Stroke="{DynamicResource ModalLine}" Background="{DynamicResource ModalSurface}" Padding="22">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <VerticalStackLayout Spacing="6"><Label Text="FILES IN CLUSTER RANGE" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label x:Name="ClusterTitle" Text="Cluster contents" FontSize="24" FontAttributes="Bold" /><Label x:Name="ClusterSubtitle" FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout>
          <ActivityIndicator x:Name="ClusterLookupSpinner" Grid.Row="1" IsVisible="False" IsRunning="False" HorizontalOptions="Center" VerticalOptions="Center" />
          <CollectionView x:Name="ClusterFilesList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnClusterFileSelected"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{DynamicResource OptionStroke}" Background="{DynamicResource OptionSurface}" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,7">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal" />
                <VisualState Name="Selected"><VisualState.Setters>
                  <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
                  <Setter Property="Stroke" Value="{DynamicResource HighlightText}" />
                </VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid ColumnDefinitions="*,100,110" RowDefinitions="Auto,Auto" ColumnSpacing="10"><Label Text="{Binding DisplayPath}" FontSize="12" LineBreakMode="MiddleTruncation" MaxLines="1" /><Label Grid.Row="1" Text="{Binding Status}" FontSize="9" TextColor="{DynamicResource SubtleText}" /><Label Grid.Column="1" Text="{Binding ClusterLabel}" FontSize="11" HorizontalOptions="End" /><Label Grid.Column="2" Text="{Binding BytesLabel}" FontSize="11" HorizontalOptions="End" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="No file-backed streams overlap this range." Padding="20" HorizontalTextAlignment="Center" TextColor="{DynamicResource Muted}" /></CollectionView.EmptyView></CollectionView>
          <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="8"><Button x:Name="HighlightClusterFileButton" Text="Highlight selected" Clicked="OnHighlightClusterFile" IsEnabled="False" BackgroundColor="{DynamicResource ActionButton}" /><Button Text="Close" Clicked="OnCloseClusterFiles" /></HorizontalStackLayout>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="DiagnosticsOverlay" IsVisible="False" BackgroundColor="{DynamicResource Overlay}" Padding="28" ZIndex="90">
      <Border Style="{StaticResource Card}" WidthRequest="900" MaximumHeightRequest="820" HorizontalOptions="Center" VerticalOptions="Center" Stroke="{DynamicResource ModalLine}" Background="{DynamicResource ModalSurface}" Padding="24">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
          <VerticalStackLayout Spacing="9">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
              <Label Text="PERFORMANCE DETAILS" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End"><Label Text="ELAPSED" Style="{StaticResource Caption}" HorizontalTextAlignment="End" /><Label x:Name="DiagnosticsElapsed" Text="00:00:00" FontSize="16" FontFamily="OpenSansSemibold" HorizontalTextAlignment="End" /></VerticalStackLayout>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label x:Name="DiagnosticsTitle" Text="Waiting for job telemetry" FontSize="23" FontAttributes="Bold" /><ActivityIndicator x:Name="DiagnosticsBusy" Grid.Column="1" Color="{DynamicResource Accent}" VerticalOptions="Center" /></Grid>
            </Grid>
            <ProgressBar x:Name="DiagnosticsProgress" ProgressColor="{DynamicResource Accent}" BackgroundColor="{DynamicResource Track}" />
            <Label x:Name="DiagnosticsCount" FontSize="12" TextColor="{DynamicResource Muted}" />
          </VerticalStackLayout>
          <ScrollView Grid.Row="1"><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="COMPRESSION" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Status" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailStatus" Grid.Column="1" Grid.ColumnSpan="3" Text="Not configured" FontSize="11" />
                <Label Grid.Row="1" Text="Current file" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailCurrent" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="—" FontSize="11" LineBreakMode="MiddleTruncation" MaxLines="1" />
                <Label Grid.Row="2" Text="Waiting" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailWaiting" Grid.Row="2" Grid.Column="1" Text="0 files · 0 B" FontSize="11" />
                <Label Grid.Row="2" Grid.Column="2" Text="Processed" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailProcessed" Grid.Row="2" Grid.Column="3" Text="0 / 0 files" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Text="Queued input" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailQueuedBytes" Grid.Row="3" Grid.Column="1" Text="0 B" FontSize="11" />
                <Label Grid.Row="3" Grid.Column="2" Text="Processed input" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailProcessedBytes" Grid.Row="3" Grid.Column="3" Text="0 B" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="4" Text="Changed" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailChanged" Grid.Row="4" Grid.Column="1" Text="0 files" FontSize="11" />
                <Label Grid.Row="4" Grid.Column="2" Text="Skipped / failed" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailSkippedFailed" Grid.Row="4" Grid.Column="3" Text="0 / 0 files" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
              <Grid ColumnDefinitions="130,*" ColumnSpacing="12"><Label Text="Storage change" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="CompressionDetailSaved" Grid.Column="1" Text="0 B saved" FontSize="11" /></Grid>
            </VerticalStackLayout></Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="PROCESS" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Logical processors" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsProcessors" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Text="Process threads" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsThreads" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="2" Text="CPU time / limit" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsCpu" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Text="Memory in use" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsMemory" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
            </VerticalStackLayout></Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="JOB TOTALS" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Moves planned" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsPlanned" Grid.Column="1" Text="0" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Text="Moves verified" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsVerified" Grid.Row="1" Grid.Column="1" Text="0" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="2" Text="Moves failed" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsFailed" Grid.Row="2" Grid.Column="1" Text="0" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Text="Data relocated" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="DiagnosticsRelocated" Grid.Row="3" Grid.Column="1" Text="0 B" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
            </VerticalStackLayout></Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="FILESYSTEM SCAN" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Status" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ScanStatus" Grid.Column="1" Text="Not started" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Text="Progress" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ScanProgress" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="2" Text="Throughput" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ScanRate" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Text="Workers" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ScanWorkers" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="4" Text="Requests" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ScanRequests" Grid.Row="4" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
            </VerticalStackLayout></Border>
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="EXECUTION PLAN" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Status" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="PlanningStatus" Grid.Column="1" Text="Not started" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Text="Progress" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="PlanningProgress" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="2" Text="Throughput" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="PlanningRate" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="3" Text="Workers" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="PlanningWorkers" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="4" Text="Requests" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="PlanningRequests" Grid.Row="4" Grid.Column="1" Text="—" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
            </VerticalStackLayout></Border>
            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="14"><VerticalStackLayout Spacing="9">
              <Label Text="RELOCATION" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
              <Grid ColumnDefinitions="130,*,130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <Label Text="Status" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionStatus" Grid.Column="1" Text="Not started" FontSize="11" />
                <Label Grid.Column="2" Text="Progress" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionProgress" Grid.Column="3" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="1" Text="Data rate" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionRate" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" />
                <Label Grid.Row="1" Grid.Column="2" Text="Workers" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionWorkers" Grid.Row="1" Grid.Column="3" Text="—" FontSize="11" HorizontalTextAlignment="End" />
                <Label Grid.Row="2" Text="Data processed" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionBytes" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" />
                <Label Grid.Row="2" Grid.Column="2" Text="Requests" FontSize="11" TextColor="{DynamicResource Muted}" /><Label x:Name="ExecutionRequests" Grid.Row="2" Grid.Column="3" Text="—" FontSize="11" HorizontalTextAlignment="End" />
              </Grid>
            </VerticalStackLayout></Border>
          </Grid></ScrollView>
          <HorizontalStackLayout Grid.Row="2" HorizontalOptions="End" Spacing="8"><Button x:Name="DiagnosticsPause" Text="Pause" Clicked="OnPause" /><Button x:Name="DiagnosticsCancel" Text="Cancel job" Clicked="OnCancel" /><Button Text="Close details" Clicked="OnClosePerformanceDetails" /></HorizontalStackLayout>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="AlgorithmOverlay" IsVisible="False" BackgroundColor="{DynamicResource Overlay}" Padding="60" ZIndex="100">
      <Border Style="{StaticResource Card}" WidthRequest="780" MaximumHeightRequest="790" HorizontalOptions="Center" VerticalOptions="Fill" Stroke="{DynamicResource ModalLine}" Background="{DynamicResource ModalSurface}" Padding="22">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <VerticalStackLayout Spacing="6"><Label Text="CHOOSE OPTIMIZATION METHOD" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" /><Label Text="What should this operation do?" FontSize="24" FontAttributes="Bold" /><Label Text="Methods are ordered by general usefulness. Specialized and potentially high-write operations appear lower." FontSize="11" TextColor="{DynamicResource Muted}" /></VerticalStackLayout>
          <CollectionView x:Name="PolicyList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnPolicySelected"><CollectionView.ItemTemplate><DataTemplate><Border Stroke="{DynamicResource OptionStroke}" Background="{DynamicResource OptionSurface}" StrokeShape="RoundRectangle 10" Padding="13" Margin="0,0,0,8"><Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"><Border Grid.RowSpan="2" WidthRequest="38" HeightRequest="38" Background="{DynamicResource OptionIconSurface}" Stroke="{DynamicResource OptionIconStroke}" StrokeShape="RoundRectangle 19" VerticalOptions="Center"><Label Text="{Binding Icon}" FontSize="19" TextColor="{DynamicResource Accent}" HorizontalOptions="Center" VerticalOptions="Center" /></Border><Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="10" TextColor="{DynamicResource Muted}" LineHeight="1.25" /><Label Grid.Column="2" Grid.RowSpan="2" Text="›" FontSize="24" TextColor="{DynamicResource Chevron}" VerticalOptions="Center" /></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
          <Button Grid.Row="2" Text="Cancel" Clicked="OnCancelPolicy" BackgroundColor="{DynamicResource ButtonSurface}" HorizontalOptions="End" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
