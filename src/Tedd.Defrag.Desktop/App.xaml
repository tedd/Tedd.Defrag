<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Tedd.Defrag.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Canvas">#0A1018</Color><Color x:Key="Surface">#101A26</Color>
      <Color x:Key="Line">#233140</Color><Color x:Key="Accent">#54D5CB</Color>
      <Color x:Key="Ink">#E5EEF4</Color><Color x:Key="Muted">#91A2B4</Color>
      <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="FontFamily" Value="OpenSansRegular" /><Setter Property="FontSize" Value="13" /></Style>
      <Style TargetType="Button"><Setter Property="BackgroundColor" Value="#1B2B3A" /><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="CornerRadius" Value="9" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="16,11" /><Setter Property="MinimumHeightRequest" Value="38" /></Style>
      <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="PlaceholderColor" Value="#667D92" /><Setter Property="BackgroundColor" Value="#152231" /><Setter Property="FontSize" Value="12" /></Style>
      <Style TargetType="Picker"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="TitleColor" Value="{StaticResource Muted}" /><Setter Property="BackgroundColor" Value="#152231" /><Setter Property="FontSize" Value="12" /></Style>
      <Style TargetType="Switch"><Setter Property="OnColor" Value="{StaticResource Accent}" /><Setter Property="ThumbColor" Value="#E5EEF4" /></Style>
      <Style TargetType="Slider"><Setter Property="MinimumTrackColor" Value="{StaticResource Accent}" /><Setter Property="MaximumTrackColor" Value="#29394C" /><Setter Property="ThumbColor" Value="{StaticResource Accent}" /></Style>
      <Style x:Key="Card" TargetType="Border"><Setter Property="Stroke" Value="{StaticResource Line}" /><Setter Property="Background" Value="{StaticResource Surface}" /><Setter Property="StrokeShape" Value="RoundRectangle 14" /><Setter Property="Padding" Value="18" /></Style>
      <Style x:Key="Caption" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="11" /><Setter Property="CharacterSpacing" Value="1" /></Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
